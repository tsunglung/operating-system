From 0d6603af5c0d06b70f7d023049734b3a218d1671 Mon Sep 17 00:00:00 2001
From: Tsunglung Yang <tsunglung.yang@latticeworkinc.com>
Date: Thu, 25 Jun 2026 14:44:21 +0800
Subject: [PATCH 2/2] arch: arm64: boot: dts: enable npu for Nanopi M5

---
 .../boot/dts/rockchip/rk3576-nanopi-m5.dts    | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)
 mode change 100644 => 100755 arch/arm64/boot/dts/rockchip/rk3576-nanopi-m5.dts

diff --git a/arch/arm64/boot/dts/rockchip/rk3576-nanopi-m5.dts b/arch/arm64/boot/dts/rockchip/rk3576-nanopi-m5.dts
old mode 100644
new mode 100755
index 8275d4789..87e2fd9da
--- a/arch/arm64/boot/dts/rockchip/rk3576-nanopi-m5.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3576-nanopi-m5.dts
@@ -866,6 +866,36 @@ &saradc {
 	status = "okay";
 };
 
+&vdec {
+	status = "okay";
+};
+
+&vdec_mmu {
+	status = "okay";
+};
+
+&vdd_npu_s0 {
+	regulator-always-on;
+};
+
+&rknn_core_0 {
+	npu-supply = <&vdd_npu_s0>;
+	status = "okay";
+};
+
+&rknn_core_1 {
+	npu-supply = <&vdd_npu_s0>;
+	status = "disabled";
+};
+
+&rknn_mmu_0 {
+	status = "okay";
+};
+
+&rknn_mmu_1 {
+	status = "disabled";
+};
+
 &sdmmc {
 	bus-width = <4>;
 	cap-mmc-highspeed;
-- 
2.50.1

