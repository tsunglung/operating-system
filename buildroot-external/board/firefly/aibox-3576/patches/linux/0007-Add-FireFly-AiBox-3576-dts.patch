From 86ebb4038128b038eb1c9bbf534088d3da263406 Mon Sep 17 00:00:00 2001
From: Tsunglung Yang <zonglong@gmail.com>
Date: Mon, 4 May 2026 17:57:54 +0800
Subject: [PATCH 7/7] Add FireFly AiBox-3576 dts

---
 .../rockchip/rk3576-firefly-aibox-3576.dts    |  35 +
 .../rockchip/rk3576-firefly-aibox-3576.dtsi   | 707 ++++++++++++++++++
 .../dts/rockchip/rk3576-firefly-common.dtsi   | 665 ++++++++++++++++
 .../dts/rockchip/rk3576-firefly-core.dtsi     | 233 ++++++
 .../arm64/boot/dts/rockchip/rk3576-linux.dtsi |  74 ++
 5 files changed, 1714 insertions(+)
 create mode 100755 arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dts
 create mode 100755 arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dtsi
 create mode 100755 arch/arm64/boot/dts/rockchip/rk3576-firefly-common.dtsi
 create mode 100755 arch/arm64/boot/dts/rockchip/rk3576-firefly-core.dtsi
 create mode 100755 arch/arm64/boot/dts/rockchip/rk3576-linux.dtsi

diff --git a/arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dts b/arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dts
new file mode 100755
index 000000000..399c91b94
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dts
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2024 Rockchip Electronics Co., Ltd.
+ *
+ */
+
+/dts-v1/;
+
+#define HDMI 1
+#define N_LED 1
+#define N_RTC 1
+#define C_WATCH_DOG 1
+#define M_WATCH_DOG 0
+#define SDCARD 1
+#define UFS 1
+#define GMAC0 1
+#define GMAC1 1
+#define FAN 1
+#define FAN_FG 1
+#define CONTROLLER0_USBA30 1
+#define CONTROLLER1_USBA30 1
+
+#define CONTROLLER0_TYPEC_USB20 1
+
+#define PCIE0 0
+#define PCIE1 0
+#define SATA0 0
+#define SATA1 1
+
+#include "rk3576-firefly-aibox-3576.dtsi"
+/ {
+	model = "Firefly AiBOX-3576 Linux";
+	compatible = "rockchip,rk3576-firefly-aibox", "rockchip,rk3576";
+};
+
diff --git a/arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dtsi
new file mode 100755
index 000000000..0138d09f7
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3576-firefly-aibox-3576.dtsi
@@ -0,0 +1,707 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2024 Rockchip Electronics Co., Ltd.
+ *
+ */
+
+#include "rk3576-firefly-common.dtsi"
+
+#define	ROCKCHIP_VOP2_CLUSTER0	0
+#define	ROCKCHIP_VOP2_CLUSTER1	1
+#define	ROCKCHIP_VOP2_ESMART0	2
+#define	ROCKCHIP_VOP2_ESMART1	3
+#define	ROCKCHIP_VOP2_SMART0	4
+#define	ROCKCHIP_VOP2_SMART1	5
+#define	ROCKCHIP_VOP2_CLUSTER2	6
+#define	ROCKCHIP_VOP2_CLUSTER3	7
+#define	ROCKCHIP_VOP2_ESMART2	8
+#define	ROCKCHIP_VOP2_ESMART3	9
+
+#define	ROCKCHIP_VOP2_PHY_ID_INVALID	-1
+/ {
+	aliases {
+#if GMAC0
+		ethernet0 = &gmac0;
+#endif
+#if GMAC1
+		ethernet1 = &gmac1;
+#endif
+	};
+
+	chosen: chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	hdmi-con {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
+	vcc3v3_pcie1: regulator-vcc3v3-pcie1 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_pcie1";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <5000>;
+		vin-supply = <&vcc12v_dcin>;
+	};
+
+	vcc5v0_host: regulator-vcc5v0-host {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_host";
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&vcc5v0_device>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_host_pwren>;
+	};
+
+	vcc_1v8_s0: vcc-1v8-s0 {
+                compatible = "regulator-fixed";
+                regulator-name = "vcc_1v8_s0";
+                regulator-boot-on;
+                regulator-always-on;
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+                vin-supply = <&vcc_1v8_s3>;
+        };
+
+	vcc_3v3_s0: vcc-3v3-s0 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_3v3_s0";
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc_3v3_s3>;
+	};
+
+	vcc5v0_sys: vcc5v0-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&vcc12v_dcin>;
+	};
+
+	vcc1v8_sys: vcc1v8-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc1v8_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&vcc12v_dcin>;
+	};
+
+	vcc3v3_sys: vcc3v3-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc12v_dcin>;
+	};
+
+#if CONTROLLER0_USBA30
+	usb3_host0_typec0_sw: usb3-host0-typec0-sw {
+                compatible = "regulator-fixed";
+                regulator-name = "usb3_host0_typec0_sw";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+                regulator-always-on;
+                enable-active-high;
+                gpio = <&gpio1 RK_PB4 GPIO_ACTIVE_HIGH>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&usb3_host0_typec0_sw_en>;
+	};
+	usb3_host0_typec0_sw1: usb3-host0-typec0-sw1 {
+                compatible = "regulator-fixed";
+                regulator-name = "usb3_host0_typec0_sw1";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+                regulator-always-on;
+                enable-active-high;
+                gpio = <&gpio2 RK_PB0 GPIO_ACTIVE_HIGH>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&usb3_host0_typec0_sw1_en>;
+	};
+#endif
+
+#if CONTROLLER1_USBA30
+	usb3_pcie1_sel: usb3-pcie1-sel {
+		compatible = "regulator-fixed";
+                regulator-name = "usb3_pcie1_sel";
+                regulator-boot-on;
+                regulator-always-on;
+                regulator-min-microvolt = <3300000>;
+                regulator-max-microvolt = <3300000>;
+                enable-active-high;
+                gpio = <&gpio0 RK_PD1 GPIO_ACTIVE_LOW>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&usb3_pcie1_sel_en>;
+	};
+#endif
+
+#if CONTROLLER0_TYPEC_USB20
+	vbus5v0_typec: vbus5v0-typec {
+		status = "okay";
+		compatible = "regulator-fixed";
+		regulator-name = "vbus5v0_typec";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-boot-on;
+		regulator-always-on;
+		enable-active-high;
+		gpio = <&gpio1 RK_PB5 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vbus5v0_typec_en>;
+		vin-supply = <&vcc5v0_sys>;
+	};
+#endif
+
+#if SDCARD
+	sdmmc_pwr: sdmmc-pwr {
+		status = "okay";
+		compatible = "regulator-fixed";
+		regulator-name = "sdmmc_pwr";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+                regulator-always-on;
+		enable-active-high;
+		gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
+	};
+#endif
+
+#if N_LED
+	firefly_leds: leds {
+                compatible = "gpio-leds";
+                status = "okay";
+                power_led: power {
+                        label = ":power"; //blue led
+                        linux,default-trigger = "ir-power-click";
+                        default-state = "on";
+                        gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_HIGH>;
+                        pinctrl-names = "default";
+                        pinctrl-0 = <&led_power>;
+                };
+                user_led: user {
+                        label = ":user"; //red led
+                        linux,default-trigger = "ir-user-click";
+                        default-state = "off";
+                        gpios = <&gpio1 RK_PD4 GPIO_ACTIVE_HIGH>;
+                        pinctrl-names = "default";
+                        pinctrl-0 = <&led_user>;
+                };
+                work_led: work {
+                        label = ":work"; //green led
+                        linux,default-trigger = "ir-user-click";
+                        default-state = "off";
+                        gpios = <&gpio1 RK_PC4 GPIO_ACTIVE_HIGH>;
+                        pinctrl-names = "default";
+                        pinctrl-0 = <&led_work>;
+                };
+        };
+#endif
+};
+
+#if CONTROLLER0_USBA30
+&vcc5v0_host0 {
+	gpio = <&gpio1 RK_PC1 GPIO_ACTIVE_HIGH>;
+        vin-supply = <&vcc5v0_sys>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&usb_host0_pwren>;
+};
+#endif
+
+
+#if CONTROLLER1_USBA30
+&vcc5v0_host1 {
+        vin-supply = <&vcc5v0_host0>;
+	/delete-property/gpio;
+        /delete-property/pinctrl-names;
+        /delete-property/pinctrl-0;
+};
+#endif
+
+#if CONTROLLER0_TYPEC_USB20
+&combphy0_ps {
+	status = "okay";
+};
+
+&usbdp_phy {
+	status = "okay";
+};
+
+&usbdp_phy_dp {
+       status = "okay";
+};
+
+&usb_drd0_dwc3 {
+        status = "okay";
+        dr_mode = "host";
+        phy-supply = <&vcc5v0_host0>;
+        //usb-role-switch;
+        port {
+                #address-cells = <1>;
+                #size-cells = <0>;
+                usb_drd0_role_switch: endpoint@0 {
+                        reg = <0>;
+                        remote-endpoint = <&usbc0_role_sw>;
+                };
+        };
+};
+#endif
+
+&i2c6 {
+	status = "okay";
+	pinctrl-names = "default";
+        pinctrl-0 = <&i2c6m3_xfer>;
+
+	/* wd on mb */
+#if M_WATCH_DOG
+	pc9202_m:pc9202_m@3c {
+		status = "okay";
+		compatible = "firefly,pc9202";
+		reg = <0x3c>;
+		wd-en-gpio = <&gpio1 RK_PC3 GPIO_ACTIVE_HIGH>;
+		index = <1>;
+		driver-names = "wdt_base";
+	};
+#endif
+
+#if CONTROLLER0_TYPEC_USB20
+	usbc0: husb311@4e {
+		compatible = "hynetek,husb311";
+		reg = <0x4e>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PC4 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usbc0_int>;
+		vbus-supply = <&vbus5v0_typec>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				usbc0_role_sw: endpoint@0 {
+					remote-endpoint = <&usb_drd0_role_switch>;
+				};
+			};
+		};
+
+		usb_con: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			data-role = "dual";
+			power-role = "dual";
+			try-power-role = "sink";
+			op-sink-microwatt = <1000000>;
+			sink-pdos =
+				<PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
+			source-pdos =
+				<PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+
+			altmodes {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				altmode@0 {
+					reg = <0>;
+					svid = <0xff01>;
+					vdo = <0xffffffff>;
+				};
+			};
+
+		};
+	};
+#endif
+
+};
+
+&i2c2 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2m0_xfer>;
+
+	/* wd on core */
+#if C_WATCH_DOG
+	pc9202_c:pc9202_c@3c {
+		status = "okay";
+		compatible = "firefly,pc9202";
+		reg = <0x3c>;
+		wd-en-gpio = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
+		index = <0>;
+		driver-names = "wdt_core";
+	};
+#endif
+
+#if N_RTC
+	hym8563: hym8563@51 {
+		status = "okay";
+		compatible = "haoyu,hym8563";
+		reg = <0x51>;
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "hym8563";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hym8563_int>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PA0 IRQ_TYPE_LEVEL_LOW>;
+		wakeup-source;
+	};
+#endif
+
+};
+
+#if GMAC0
+&gmac0 {
+	status = "okay";
+	/* Use rgmii-rxid mode to disable rx delay inside Soc */
+	phy-mode = "rgmii-rxid";
+	clock_in_out = "output";
+
+	snps,reset-gpio = <&gpio4 RK_PB1 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	/* Reset time is 20ms, 100ms for rtl8211f */
+	snps,reset-delays-us = <0 20000 100000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&eth0m0_miim
+		     &eth0m0_tx_bus2
+		     &eth0m0_rx_bus2
+		     &eth0m0_rgmii_clk
+		     &eth0m0_rgmii_bus>;
+
+	tx_delay = <0x1e>;
+	/* rx_delay = <0x3f>; */
+
+	phy-handle = <&rgmii_phy0>;
+};
+
+&mdio0 {
+	status = "okay";
+	rgmii_phy0: phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x1>;
+		clocks = <&cru REFCLKO25M_GMAC0_OUT>;
+	};
+};
+#endif
+
+
+#if GMAC1
+&gmac1 {
+	status = "okay";
+	/* Use rgmii-rxid mode to disable rx delay inside Soc */
+	phy-mode = "rgmii-rxid";
+	clock_in_out = "output";
+
+	snps,reset-gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	/* Reset time is 20ms, 100ms for rtl8211f */
+	snps,reset-delays-us = <0 20000 100000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&eth1m0_miim
+		     &eth1m0_tx_bus2
+		     &eth1m0_rx_bus2
+		     &eth1m0_rgmii_clk
+		     &eth1m0_rgmii_bus>;
+
+	tx_delay = <0x1e>;
+	/* rx_delay = <0x3f>; */
+
+	phy-handle = <&rgmii_phy1>;
+};
+
+&mdio1 {
+	status = "okay";
+	rgmii_phy1: phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x1>;
+		clocks = <&cru REFCLKO25M_GMAC1_OUT>;
+	};
+};
+#endif
+
+&pinctrl {
+	bluetooth {
+		bt_reg_on: bt-reg-on {
+			rockchip,pins = <1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+
+		bt_wake_host: bt-wake-host {
+			rockchip,pins = <0 RK_PB1 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+
+		host_wake_bt: host-wake-bt {
+			rockchip,pins = <1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	hym8563 {
+		rtc_int: rtc-int {
+			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	network {
+		rgmii_phy0_rst: rgmii-phy0-rst {
+			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		rgmii_phy1_rst: rgmii-phy1-rst {
+			rockchip,pins = <3 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	pcie0 {
+		pcie0_rst: pcie0-rst {
+			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	sdmmc {
+		sdmmc_pwren: sdmmc-pwren {
+			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	usb {
+		usb_host_pwren: usb-host-pwren {
+			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		usb_otg0_pwren: usb-otg0-pwren {
+			rockchip,pins = <0 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		usbc0_int: usbc0-int {
+			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	wifi {
+		wifi_reg_on: wifi-reg-on {
+			rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+
+		wifi_wake_host: wifi-wake-host {
+			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+};
+
+&sdhci {
+	bus-width = <8>;
+	full-pwr-cycle-in-suspend;
+	max-frequency = <200000000>;
+	mmc-hs400-1_8v;
+	mmc-hs400-enhanced-strobe;
+	no-sdio;
+	no-sd;
+	non-removable;
+	status = "okay";
+};
+
+&u2phy0 {
+	status = "okay";
+};
+
+&u2phy1 {
+	status = "okay";
+};
+
+&u2phy1_otg {
+	phy-supply = <&vcc5v0_host>;
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+};
+
+#if FAN
+&fan {
+	pwms = <&pwm1_6ch_2 0 50000 0>;
+};
+
+&pwm1_6ch_2 {
+	status = "okay";
+	pinctrl-0 = <&pwm1m1_ch2>;
+};
+#endif
+
+#if FAN_FG
+&pwm1_6ch_5 {
+	status = "okay";
+	pinctrl-0 = <&pwm1m0_ch5>;
+	assigned-clocks = <&cru CLK_PWM1>;
+	assigned-clock-rates = <100000000>;
+};
+
+&pwm2_8ch_6 {
+	status = "okay";
+	pinctrl-0 = <&pwm2m2_ch6>;
+	assigned-clocks = <&cru CLK_PWM2>;
+	assigned-clock-rates = <100000000>;
+};
+#endif
+
+#if (PCIE0 == 1) || (PCIE1 == 1) || (SATA0 == 1) || (SATA1 == 1)
+&vcc3v3_pcie {
+	status = "okay";
+	gpio = <&gpio1 RK_PC5 GPIO_ACTIVE_HIGH>;
+	startup-delay-us = <5000>;
+};
+#endif
+
+#if (SATA0 == 1 || SATA1 == 1) && (PCIE0 == 0 && PCIE1 == 0)
+#if (SATA0 == 1)
+&sata0 {
+	pinctrl-0 = <&sata_reset>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+#endif
+#if (SATA1 == 1)
+&sata1 {
+	pinctrl-0 = <&sata_reset>;
+	pinctrl-names = "default";
