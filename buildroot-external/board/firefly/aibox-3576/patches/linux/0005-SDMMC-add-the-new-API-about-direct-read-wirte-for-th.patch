diff --git a/drivers/mmc/core/block.c b/drivers/mmc/core/block.c
old mode 100644
new mode 100755
index c0ffe0817..32ae2f209
--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -3261,6 +3261,7 @@ static void mmc_blk_rpmb_add(struct mmc_card *card)
 	}
 }
 
+extern struct mmc_card *this_card;
 static int mmc_blk_probe(struct mmc_card *card)
 {
 	struct mmc_blk_data *md;
@@ -3308,6 +3309,11 @@ static int mmc_blk_probe(struct mmc_card *card)
 
 	mmc_blk_rpmb_add(card);
 
+#if defined(CONFIG_MMC_DW_ROCKCHIP)
+    if(card->host->restrict_caps & RESTRICT_CARD_TYPE_EMMC)
+        this_card = card;
+#endif
+
 	return 0;
 
 out:
@@ -3322,6 +3328,11 @@ static void mmc_blk_remove(struct mmc_card *card)
 {
 	struct mmc_blk_data *md = dev_get_drvdata(&card->dev);
 
+#if defined(CONFIG_MMC_DW_ROCKCHIP)
+    if(card->host->restrict_caps & RESTRICT_CARD_TYPE_EMMC)
+        this_card = NULL;
+#endif
+
 	mmc_blk_remove_debugfs(card, md);
 	mmc_blk_remove_parts(card, md);
 	pm_runtime_get_sync(&card->dev);
