From 2dcf62d6a1d77c22029a68ba7bf0749d675fc64c Mon Sep 17 00:00:00 2001
From: Tsunglung Yang <zonglong@gmail.com>
Date: Thu, 14 May 2026 08:53:51 +0800
Subject: [PATCH 1/2] arch: arm: mach-rockchip: support loader mode

---
 arch/arm/mach-rockchip/boot_mode.c | 4 ++++
 1 file changed, 4 insertions(+)
 mode change 100644 => 100755 arch/arm/mach-rockchip/boot_mode.c

diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
index 55e94566..ca378e27
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -105,6 +105,10 @@ int setup_boot_mode(void)
 		debug("%s: enter UMS!\n", __func__);
 		env_set("preboot", "setenv preboot; ums mmc 0");
 		break;
+	case BOOT_LOADER:
+		printf("%s: enter Rockusb!\n", __func__);
+		env_set("preboot", "setenv preboot; rockusb 0 mmc 0");
+		break;
 	}
 
 	return 0;
-- 
