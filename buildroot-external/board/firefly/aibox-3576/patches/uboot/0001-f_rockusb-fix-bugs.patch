+static void cb_switch_storage(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	u32 media = BOOT_TYPE_UNKNOWN;
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+	media = 1 << cbw->CDB[1];
+
+	if (!f_rkusb->desc) {
+
+		switch (media) {
+#ifdef CONFIG_MMC
+			case BOOT_TYPE_EMMC:
+				strcpy(f_rkusb->dev_type, "mmc");
+				break;
+#endif
+#ifdef CONFIG_SPI_FLASH
+			case BOOT_TYPE_MTD_BLK_SPI_NOR:
+				strcpy(f_rkusb->dev_type, "sf");
+				f_rkusb->dev_index = 0;
+				break;
+#endif
+#ifdef CONFIG_NVME
+			case BOOT_TYPE_PCIE:
+				strcpy(f_rkusb->dev_type, "nvme");
+				f_rkusb->dev_index = 0;
+				run_command("pci enum", 0);
+				run_command("sleep 1", 0);
+				run_command("nvme scan", 0);
+				break;
+#endif
+#ifdef CONFIG_UFS
+			case BOOT_TYPE_UFS:
+				strcpy(f_rkusb->dev_type, "ufs");
+				f_rkusb->dev_index = 0;
+				break;
+#endif
+#ifdef CONFIG_USB_STORAGE
+			case BOOT_TYPE_UMS:
+				strcpy(f_rkusb->dev_type, "usb");
+				f_rkusb->dev_index = 0;
+				break;
+#endif
+		}
+	}
+
+	rockusb_tx_write_csw(cbw->tag, cbw->data_transfer_length,
+			     CSW_GOOD, USB_BULK_CS_WRAP_LEN);
+}
+
+static void cb_get_storage_media(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	u32 media = BOOT_TYPE_UNKNOWN;
+	u8 buf[4];
+
+	if (!f_rkusb->desc) {
+		char *type = f_rkusb->dev_type;
+#ifdef CONFIG_MMC
+		if (strcmp(type, "mmc") == 0)
+			media = BOOT_TYPE_EMMC;
+#endif
+#ifdef CONFIG_SPI_FLASH
+		if (strcmp(type, "sf") == 0)
+			media = BOOT_TYPE_MTD_BLK_SPI_NOR;
+#endif
+#ifdef CONFIG_NVME
+		if (strcmp(type, "nvme") == 0)
+			media = BOOT_TYPE_PCIE;
+#endif
+#ifdef CONFIG_UFS
+		if (strcmp(type, "ufs") == 0)
+			media = BOOT_TYPE_UFS;
+#endif
+#ifdef CONFIG_USB_STORAGE
+		if (strcmp(type, "usb") == 0)
+			media = BOOT_TYPE_UMS;
+#endif
+		}
+	memcpy(buf, &media, sizeof(buf));
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+
+	/* Prepare for sending subsequent CSW_GOOD */
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+
+	rockusb_tx_write((char *)buf, sizeof(media));
+}
+
+static void cb_read_capability(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	u32 len = 8;
+	u8 capability_info[len];
+	memset(capability_info, 0x0, sizeof(capability_info));
+
+	/*
+	 * bit[0]: Direct LBA, 0: Disabled;
+	 * bit[1]: Vendor Storage API, 0: Disabed (default);
+	 * bit[2]: First 4M Access, 0: Disabled;
+	 * bit[3]: Read LBA On, 0: Disabed (default);
+	 * bit[4]: New Vendor Storage API, 0: Disabed;
+	 * bit[5]: Read uart data from ram
+	 * bit[6]: Read IDB config
+	 * bit[7]: Read SecureMode
+	 * bit[8]: New IDB feature
+	 * bit[9]: Get storage media info
+	 * bit[10]: LBAwrite Parity
+	 * bit[11]: Read Otp Data
+	 * bit[12]: usb3 download
+	 * bit[13]: Write OTP proof
+	 * bit[14]: Write Cipher Key
+	 * bit[15:63}: Reserved.
+	 */
+
+	capability_info[0] = BIT(0) | BIT(2) | BIT(4);
+
+#ifdef CONFIG_PSTORE
+	capability_info[0] |= (1 << 5);
+#endif
+
+	capability_info[1] = BIT(0);  /* new idb */
+	capability_info[1] |= BIT(1); /* Switch Storage */
+	capability_info[1] |= BIT(2); /* LBAwrite Parity */
+
+	capability_info[1] &= ~BIT(4);
+
+#ifdef CONFIG_ROCKCHIP_OTP
+	capability_info[1] |= BIT(3); /* Read Otp Data */
+	capability_info[1] |= BIT(5); /* Write OTP proof */
+	capability_info[1] |= BIT(6); /* Write Cipher Key */
+#endif
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+
+	/* Prepare for sending subsequent CSW_GOOD */
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+
+	rockusb_tx_write((char *)capability_info, len);
+}
+
+static void cb_read_flash_info(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+
+	u32 len = sizeof(struct rk_flash_info);
+
+	ALLOC_CACHE_ALIGN_BUFFER(struct rk_flash_info, finfo, len);
+	finfo->block_size = ROCKCHIP_FLASH_BLOCK_SIZE;
+	finfo->page_size = ROCKCHIP_FLASH_PAGE_SIZE;
+	finfo->access_time = 40;
+
+	char *type = f_rkusb->dev_type;
+	u8 flash_info[len];
+
+	if (strcmp(type, "nvme") == 0) {
+		run_command("pci enum", 0);
+		run_command("sleep 1", 0);
+		run_command("nvme scan", 0);
+	}
+
+	if (strcmp(type, "sf") == 0) {
+		run_command("sf probe", 0);
+	}
+
+#ifdef CONFIG_USB_STORAGE
+	if (strcmp(type, "usb") == 0) {
+		run_command("usb stop", 0);
+		run_command("sleep 1", 0);
+		run_command("usb start", 0);
+	}
+#endif
+
+	if (!f_rkusb->desc) {
+		int index = f_rkusb->dev_index;
+
+		f_rkusb->desc = blk_get_dev(type, index);
+		if (!f_rkusb->desc ||
+			f_rkusb->desc->type == DEV_TYPE_UNKNOWN) {
+				printf("invalid device \"%s\", %d\n", type, index);
+				rockusb_tx_write_csw(f_rkusb->tag, 0, CSW_FAIL,
+							USB_BULK_CS_WRAP_LEN);
+				return;
+		}
+	}
+
+	finfo->flash_size = (u32)f_rkusb->desc->lba;
+
+	debug("Flash info: block_size = %x page_size = %x flash_size = %x\n", finfo->block_size, finfo->page_size, finfo->flash_size);
+
+	if (finfo->flash_size)
+		finfo->flash_mask = 1;
+
+	memset((void *)flash_info, 0xff, len);
+	memcpy((void *)flash_info, (void *)finfo, len);
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+
+	/* Prepare for sending subsequent CSW_GOOD */
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+
+	rockusb_tx_write((char *)flash_info, len);
+}
+
+static void cb_test_bad_block(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	u32 len = 64;
+	u8 buf[len];
+	memset(buf, 0, len);
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+
+	/* Prepare for sending subsequent CSW_GOOD */
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+
+	rockusb_tx_write(buf, len);
+}
+
+/* high 24 bits is tag, low 8 bits is type */
+#define REBOOT_FLAG		0x5242C300
+/* cold boot */
+#define BOOT_COLD		0
+/* normal boot */
+#define BOOT_NORMAL		(REBOOT_FLAG + 0)
+/* enter loader rockusb mode */
+#define BOOT_LOADER		(REBOOT_FLAG + 1)
+/* enter bootrom download mode */
+#define BOOT_BROM_DOWNLOAD	0xEF08A53C
+
 void __weak rkusb_set_reboot_flag(int flag)
 {
 	struct f_rockusb *f_rkusb = get_rkusb();
 
-	printf("rockkusb set reboot flag: %d\n", f_rkusb->reboot_flag);
+	u32 boot_flag = BOOT_NORMAL;
+
+	if (f_rkusb->reboot_flag == 0x03)
+		boot_flag = BOOT_BROM_DOWNLOAD;
+	else if (f_rkusb->reboot_flag == 0x06)
+		boot_flag = BOOT_LOADER;
+
+	f_rkusb->reboot_flag = 0; /* restore to default */
+	writel(boot_flag, (void *)CONFIG_ROCKCHIP_BOOT_MODE_REG);
+
+	debug("rockkusb set reboot flag: %d\n", f_rkusb->reboot_flag);
 }
 
